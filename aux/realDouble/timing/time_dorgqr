      PROGRAM TIME_DORGQR
         ! Local Scalars
         INTEGER M,N,K
         ! Local Arrays
         DOUBLE PRECISION, ALLOCATABLE :: T(:,:), Q(:,:), TAU(:)
         DOUBLE PRECISION, DIMENSION(5) :: QRTIMES, QRPERF
         ! Intrinsic Functions
         INTRINSIC CPU_TIME
         ! External Functions
         ! External Subroutines
         ! Beginning of executable statements
         ! First, we read in the dimensions
         WRITE(*,*) "Provide M >= N >= K for testing DORGQR methods"
         READ(*,*) M, N, K
         ! Allocate our memory
         ALLOCATE(A(M,K))
         ALLOCATE(T(K,K))
         ALLOCATE(TAU(N))
         ! Fill all our arrays with random data
         CALL FILL_ARRAYS(N,K,Q,T,TAU)

         QRTIMES = TIME_QR(N,K,Q,T,TAU)

      END PROGRAM

      SUBROUTINE FILL_ARRAYS( N, K, Q, T, TAU )
         INTEGER N,K
         DOUBLE PRECISION Q(N,K),T(K,K),TAU(N)
         CALL RANDOM_NUMBER(Q)
         CALL RANDOM_NUMBER(T)
         CALL RANDOM_NUMBER(TAU)
      END SUBROUTINE

      ! This function converts the outputs of TIME_QR into the performance
      ! metrics
      FUNCTION PERF_QR(TIMEQR)
         DOUBLE PRECISION, DIMENSION(5) TIMEQR, PERF_QR
      END FUNCTION

      ! We are timing the execution of forming Q for the QR decomposition
      ! starting with the V matrix
      FUNCTION TIME_QR(M, N, K, Q, T, WORKVEC, TAU)
         INTEGER N, K
         DOUBLE PRECISION Q(M,K), T(K,K)
         ! REF_TIME, OPT_TIME, REC_TIME, UT_MULT_TIME, UT_SOLVE_TIME
         DOUBLE PRECISION, DIMENSION(5) :: TEST_QR
         DOUBLE PRECISION STARTTIME, STOPTIME

         DOUBLE PRECISION, ALLOCATABLE :: WORK

         INTEGER NEG_ONE, LWORK, INFO
         PARAMETER(NEG_ONE=-1)

         ALLOCATE(WORK(1))

         ! Workspace queries
         ! Factorization
         CALL DGEQRF(N, K, Q, N, TAU, WORK, NEG_ONE, INFO)
         LWORK = INT(WORK(1))
         ! Reference (recursive)
         CALL DORGQR_REF(N, K, K, Q, N, TAU, WORK, NEG_ONE, INFO)
         LWORK = MAX(LWORK,INT(WORK(1)))
         ! Optimized
         CALL DORGQR(N, K, K, Q, N, TAU, WORK, NEG_ONE, INFO)
         LWORK = MAX(LWORK,INT(WORK(1)))
         ! UT with multiplication
         CALL DORGQR_UT_MULT(N, K, K, Q, N, TAU, WORK, NEG_ONE, INFO)
         LWORK = MAX(LWORK,INT(WORK(1)))
         ! UT with solving
         CALL DORGQR_UT_SOLVE(N, K, K, Q, N, TAU, WORK, NEG_ONE, INFO)
         LWORK = MAX(LWORK,INT(WORK(1)))
         ! Now, we factorize Q
         CALL DGEQRF(N)
         CALL CPU_TIME(STARTTIME)
      END FUNCTION
