#!/bin/env bash
# time_all.batch
# Batch job that runs tests of my new Q computation algorithms for varying precisions
# Johnathan Rhyne
#SBATCH --job-name=run_all.sh
#SBATCH --partition=math-alderaan
#SBATCH --time=24:00:00
#SBATCH --ntasks=12

dateString=$(date "+%d.%B.%Y")
./run_square.sh > "squareTiming.$dateString.txt"
./run_tall.sh > "tallTiming.$dateString.txt"
